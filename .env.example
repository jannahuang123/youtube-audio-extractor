PORT=8080
MAX_CONCURRENT=2

# Bearer token used by the main application.
INTERNAL_API_TOKEN=replace-with-a-long-random-token

# Mounted as a Docker/Kubernetes secret. The file must be private (0400).
YOUTUBE_COOKIES_FILE=/run/secrets/youtube-cookies.txt

# Cloudflare R2 is S3-compatible. For AWS S3, use the corresponding endpoint,
# region, access key and secret key.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=youtube-audio
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_REGION=auto
R2_FORCE_PATH_STYLE=false

# Run `npm run storage:cleanup` from a scheduler every 5-10 minutes.
# The in-process timer is only best-effort; the scheduler makes deletion
# survive worker restarts.
